{
  "name": "jarvis-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/postbuild.mjs",
    "icons": "node scripts/make-icons.mjs",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run check && vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sveltejs/adapter-node": "^5.2.11",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
