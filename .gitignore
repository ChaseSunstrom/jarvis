node_modules/
.svelte-kit/
build/
dist/
__pycache__/
*.pyc
# setuptools writes this on every `pip install -e .`, so it was committed once
# and then quietly carried a stale file list — `SOURCES.txt` still named modules
# that had been deleted. It is generated, it is per-machine, and nothing reads
# the committed copy.
*.egg-info/
.pytest_cache/
.venv/
venv/
.env
*.local
jarvis-workspace/
!jarvis-workspace/.gitkeep
test-results/
playwright-report/
*.keystore
*.jks

# The ONE keystore that is deliberately committed. Signing every CI
# build with a stable key is what lets an update install over the
# previous one — Android refuses a signature change — so an ignored
# keystore here would silently break the in-app updater. Its password is
# public; see android-app/README.md for what that does and does not mean.
!android-app/ci-keystore.jks
# Written by the evals on every run.
evals/last_persona_run.json
evals/last_decomposition_run.json
.DS_Store

# Runtime state written into a config directory the moment the server (or
# `--create-token`) is pointed at it. All three are secrets in practice:
# .storage/auth.json holds token hashes, secrets.yaml holds the real ones, and
# jarvis.db knows when the house is empty and when the front door opened.
.storage/
secrets.yaml
*.db
*.db-wal
*.db-shm

# scripts/verify/all.sh writes one log per milestone here. It is output, not
# source, and a stale log next to a green table would be worse than no log.
.verify/
testing/live/voices/

# One installation's own features. `packages/*.yaml` is where a person adds a
# laundry cycle or the demo house to THEIR Jarvis; the shipped directory is
# empty on purpose, because a default configuration that invents devices
# nobody owns is worse than one that controls nothing. The worked examples are
# tracked, under config/examples/house/.
jarvis-core/config/packages/

# The embedding and reranker weights TEI downloads on first start (M33), for
# the same reason as `jarvis-core/wyoming/` above: hundreds of megabytes,
# fetched once, and never something a checkout should carry.
jarvis-core/models/

# The Whisper and Piper weights the Wyoming containers download on first start.
# ~200 MB, and one blob is 139 MB — over GitHub's hard limit, so a push fails
# outright with them tracked. They were committed by accident in "The console
# gets a component library"; that commit's history was rewritten before this
# branch was ever pushed.
jarvis-core/wyoming/

# Subagent worktrees the harness creates beside the checkout; never part of it.
.claude/worktrees/
