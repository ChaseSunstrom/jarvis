{
  "$meta": {
    "name": "Jarvis \u00b7 Reactor II",
    "version": 1,
    "source": "docs/design/c2-reactor.html \u2014 the chosen visual direction",
    "format": "W3C Design Tokens (DTCG) draft: groups of { \"$type\", \"$value\" } leaves; \"{group.path}\" is an alias",
    "rule": "This is the only file in the repository where a colour, size, radius, shadow or duration is typed by a human. Everything else is generated by design/build.py and checked by scripts/verify/token_lint.py.",
    "platforms": "Groups named `android` are phone-only scales (sp, dp) and are not emitted to CSS; everything else is emitted everywhere.",
    "naming": "CSS custom property = --jv-<path>, with the shorthands the console already uses: color.* \u2192 --jv-*, type.family.* \u2192 --jv-font-*, type.size.* \u2192 --jv-fs-*, type.tracking.* \u2192 --jv-track-*, elevation.glow-* \u2192 --jv-glow-*, elevation.panel/float \u2192 --jv-elev-*, motion.dur.* \u2192 --jv-dur-*, motion.ease.* \u2192 --jv-ease-*, motion.stagger.* \u2192 --jv-stagger-*, motion.reactor.* \u2192 --jv-rx-*, chrome.* \u2192 --jv-*."
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "#03070b",
      "$description": "The ground. Everything sits on this."
    },
    "bg-raised": {
      "$type": "color",
      "$value": "#050b11",
      "$description": "The ground where a region needs to read as one step up without becoming a panel."
    },
    "panel": {
      "$type": "color",
      "$value": "#070f16",
      "$description": "A panel. Flat and opaque \u2014 Reactor II has no glass."
    },
    "panel-solid": {
      "$type": "color",
      "$value": "#070f16",
      "$description": "Kept as the console's name for an opaque panel; same value as panel."
    },
    "surface-2": {
      "$type": "color",
      "$value": "#0a141c",
      "$description": "A control or row raised off a panel: the active segment of a switch, a hovered row."
    },
    "field": {
      "$type": "color",
      "$value": "#050b11",
      "$description": "An input's ground."
    },
    "surface-sunken": {
      "$type": "color",
      "$value": "#030709",
      "$description": "Inset: a diff, a console output, anything the eye should read as below the panel."
    },
    "accent": {
      "$type": "color",
      "$value": "#4fe3ff",
      "$description": "The one accent. Spent on what is live now: the current step, the level, the active tab, the single primary control."
    },
    "accent-deep": {
      "$type": "color",
      "$value": "#1fa9c9",
      "$description": "The accent at rest: the idle orb, a secondary rule, an iris arc."
    },
    "accent-lift": {
      "$type": "color",
      "$value": "#7ee6ff",
      "$description": "The lit top edge of a filled control."
    },
    "accent-ink": {
      "$type": "color",
      "$value": "#031016",
      "$description": "Text on an accent fill. Never on the ground."
    },
    "warn": {
      "$type": "color",
      "$value": "#f2b84b",
      "$description": "Held, not failed: an approval waiting on a human."
    },
    "amber": {
      "$type": "color",
      "$value": "#ff9e2c",
      "$description": "The orb's thinking state."
    },
    "gold": {
      "$type": "color",
      "$value": "#ffcf5c",
      "$description": "The orb's speaking state."
    },
    "danger": {
      "$type": "color",
      "$value": "#ff6b5c",
      "$description": "Something went wrong. Distinct from warn, which means something is waiting."
    },
    "danger-text": {
      "$type": "color",
      "$value": "#ff9184",
      "$description": "Danger as body text, lifted to clear AA on the ground."
    },
    "ok": {
      "$type": "color",
      "$value": "#6ff2c0",
      "$description": "Done, passed, approved."
    },
    "text": {
      "$type": "color",
      "$value": "#d3e6ec"
    },
    "text-bright": {
      "$type": "color",
      "$value": "#f1fafc",
      "$description": "The one line to read first: the reply, the title, the figure."
    },
    "text-dim": {
      "$type": "color",
      "$value": "#7c9ea9",
      "$description": "Supporting text. Clears AA on the ground even at 0.7 opacity."
    },
    "text-faint": {
      "$type": "color",
      "$value": "#6f8d99",
      "$description": "The quietest text that still clears AA: timestamps, units, footnotes. For marks that are not text use tick."
    },
    "tick": {
      "$type": "color",
      "$value": "#455f68",
      "$description": "Not text: bezel ticks, dashed coils, decorative dots. Below AA on purpose \u2014 nothing is read in it."
    },
    "line": {
      "$type": "color",
      "$value": "#16323f",
      "$description": "A border you should notice: a panel edge, a control outline."
    },
    "line-soft": {
      "$type": "color",
      "$value": "#0f2430",
      "$description": "A divider inside a panel."
    },
    "line-hair": {
      "$type": "color",
      "$value": "#0b1b23",
      "$description": "A hairline between rows."
    },
    "wash": {
      "$type": "color",
      "$value": "rgba(79, 227, 255, 0.08)",
      "$description": "The accent as a tint: the current row, the selected item."
    },
    "wash-strong": {
      "$type": "color",
      "$value": "rgba(79, 227, 255, 0.18)"
    },
    "glow": {
      "$type": "color",
      "$value": "rgba(79, 227, 255, 0.28)",
      "$description": "The accent as light. Budgeted: the reactor core, the current step, the push-to-talk ring."
    },
    "focus": {
      "$type": "color",
      "$value": "#4fe3ff"
    },
    "orb": {
      "$description": "The arc reactor's palette on every surface \u2014 pinned across ReactorOrb.kt, SiriPalette.kt and Orb.svelte's shader by android-app/tools/reactor_orb_test.py. Declared here so the source of truth is complete; build.py --check refuses drift rather than rewriting those files.",
      "substrate": {
        "$type": "color",
        "$value": "#060b16"
      },
      "housing": {
        "$type": "color",
        "$value": "#01030a"
      },
      "hub-metal": {
        "$type": "color",
        "$value": "#a8bdd2"
      },
      "idle": {
        "blob-0": {
          "$type": "color",
          "$value": "#2bb0d8"
        },
        "blob-1": {
          "$type": "color",
          "$value": "#3a6fe0"
        },
        "blob-2": {
          "$type": "color",
          "$value": "#29d8c0"
        },
        "core": {
          "$type": "color",
          "$value": "#dff6ff"
        }
      },
      "listening": {
        "blob-0": {
          "$type": "color",
          "$value": "#3fd8ff"
        },
        "blob-1": {
          "$type": "color",
          "$value": "#5a8cff"
        },
        "blob-2": {
          "$type": "color",
          "$value": "#54ffe0"
        },
        "core": {
          "$type": "color",
          "$value": "#ebfdff"
        }
      },
      "thinking": {
        "blob-0": {
          "$type": "color",
          "$value": "#ff9e2c"
        },
        "blob-1": {
          "$type": "color",
          "$value": "#ff5fa2"
        },
        "blob-2": {
          "$type": "color",
          "$value": "#c46bff"
        },
        "core": {
          "$type": "color",
          "$value": "#ffe9cc"
        }
      },
      "speaking": {
        "blob-0": {
          "$type": "color",
          "$value": "#ffcf5c"
        },
        "blob-1": {
          "$type": "color",
          "$value": "#ff9a3c"
        },
        "blob-2": {
          "$type": "color",
          "$value": "#ff7bc0"
        },
        "core": {
          "$type": "color",
          "$value": "#fff3d2"
        }
      },
      "error": {
        "blob-0": {
          "$type": "color",
          "$value": "#ff6b5c"
        },
        "blob-1": {
          "$type": "color",
          "$value": "#e0344b"
        },
        "blob-2": {
          "$type": "color",
          "$value": "#ff9a6b"
        },
        "core": {
          "$type": "color",
          "$value": "#ffd9d2"
        }
      }
    },
    "paper": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "The ground a QR code is printed on. Not a palette colour \u2014 a camera needs the contrast."
    }
  },
  "type": {
    "family": {
      "chrome": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "ui-monospace",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Data, timestamps, ids, code. Self-hosted from jarvis-web/static/fonts."
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Barlow",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$description": "Interface text and labels."
      },
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Space Grotesk",
          "Barlow",
          "system-ui",
          "sans-serif"
        ],
        "$description": "The reply line, big figures, screen titles \u2014 light weight, large sizes only."
      }
    },
    "size": {
      "$description": "The console's scale in rem. The floor is 0.7rem (11.2 px at a 16 px root); tokens.test.ts refuses anything smaller.",
      "2xs": {
        "$type": "dimension",
        "$value": "0.72rem"
      },
      "xs": {
        "$type": "dimension",
        "$value": "0.8rem"
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.88rem"
      },
      "md": {
        "$type": "dimension",
        "$value": "1rem"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.15rem"
      },
      "xl": {
        "$type": "dimension",
        "$value": "clamp(1.05rem, 2vw, 1.35rem)"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "clamp(1.3rem, 2.4vw, 1.65rem)"
      },
      "display": {
        "$type": "dimension",
        "$value": "clamp(1.35rem, 3.2vw, 2.5rem)"
      }
    },
    "weight": {
      "display": {
        "$type": "fontWeight",
        "$value": 300
      },
      "body": {
        "$type": "fontWeight",
        "$value": 400
      },
      "label": {
        "$type": "fontWeight",
        "$value": 500
      }
    },
    "tracking": {
      "tight": {
        "$type": "dimension",
        "$value": "0.08em"
      },
      "chrome": {
        "$type": "dimension",
        "$value": "0.16em"
      },
      "wide": {
        "$type": "dimension",
        "$value": "0.24em"
      },
      "logo": {
        "$type": "dimension",
        "$value": "0.5em"
      },
      "snug": {
        "$type": "dimension",
        "$value": "0.04em",
        "$description": "A hair of tracking on running text set in the display face."
      }
    },
    "android": {
      "$description": "The phone's type scale in sp, named for the job. Pinned by android-app/tools/type_scale_test.py as a rename, not a redesign; change it here and there together.",
      "label": {
        "$type": "dimension",
        "$value": 11
      },
      "hint": {
        "$type": "dimension",
        "$value": 12
      },
      "mono": {
        "$type": "dimension",
        "$value": 13
      },
      "body": {
        "$type": "dimension",
        "$value": 14
      },
      "field": {
        "$type": "dimension",
        "$value": 15
      },
      "response": {
        "$type": "dimension",
        "$value": 20
      },
      "title": {
        "$type": "dimension",
        "$value": 22
      }
    },
    "relative": {
      "$description": "Sizes relative to the text they sit in rather than to the root \u2014 a caret, a line. Not part of the type scale.",
      "caret": {
        "$type": "dimension",
        "$value": "1.05em",
        "$description": "A caret, sized against the line it sits in rather than the root."
      },
      "line": {
        "$type": "dimension",
        "$value": "1.5em",
        "$description": "One line of the surrounding text: the floor for a bubble that may still be empty."
      }
    }
  },
  "space": {
    "$description": "The console's rhythm in rem. 1\u20135 are the steps the chrome already uses; 6 and 7 are Reactor II's wide gutters.",
    "1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "2": {
      "$type": "dimension",
      "$value": "0.45rem"
    },
    "3": {
      "$type": "dimension",
      "$value": "0.7rem"
    },
    "4": {
      "$type": "dimension",
      "$value": "0.95rem"
    },
    "5": {
      "$type": "dimension",
      "$value": "1.4rem"
    },
    "6": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "7": {
      "$type": "dimension",
      "$value": "3rem"
    },
    "android": {
      "$description": "The phone's spacing steps in dp, named for the job (JarvisUi.Space).",
      "hairline": {
        "$type": "dimension",
        "$value": 1
      },
      "tight": {
        "$type": "dimension",
        "$value": 4
      },
      "snug": {
        "$type": "dimension",
        "$value": 6
      },
      "row": {
        "$type": "dimension",
        "$value": 10
      },
      "gap": {
        "$type": "dimension",
        "$value": 12
      },
      "section": {
        "$type": "dimension",
        "$value": 16
      },
      "screen": {
        "$type": "dimension",
        "$value": 20
      },
      "wide": {
        "$type": "dimension",
        "$value": 24
      }
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "3px"
    },
    "md": {
      "$type": "dimension",
      "$value": "6px",
      "$description": "Panels, cards, buttons, inputs. Reactor II's one radius."
    },
    "lg": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Only the dock and a floating sheet."
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "elevation": {
    "glow-sm": {
      "$type": "shadow",
      "$value": "0 0 12px rgba(79, 227, 255, 0.16)"
    },
    "glow-md": {
      "$type": "shadow",
      "$value": "0 0 18px rgba(79, 227, 255, 0.28)"
    },
    "glow-lg": {
      "$type": "shadow",
      "$value": "0 0 34px rgba(79, 227, 255, 0.45)"
    },
    "panel": {
      "$type": "shadow",
      "$value": "0 18px 40px -28px rgba(0, 0, 0, 0.95)"
    },
    "float": {
      "$type": "shadow",
      "$value": "0 26px 60px -22px rgba(0, 0, 0, 0.95)"
    }
  },
  "motion": {
    "dur": {
      "instant": {
        "$type": "duration",
        "$value": "90ms"
      },
      "fast": {
        "$type": "duration",
        "$value": "160ms",
        "$description": "Hover, focus, a colour change."
      },
      "base": {
        "$type": "duration",
        "$value": "260ms",
        "$description": "A tab indicator sliding, a panel opening."
      },
      "slow": {
        "$type": "duration",
        "$value": "320ms"
      },
      "pulse": {
        "$type": "duration",
        "$value": "620ms"
      },
      "enter": {
        "$type": "duration",
        "$value": "900ms",
        "$description": "A panel's entrance on first paint."
      },
      "sweep": {
        "$type": "duration",
        "$value": "1.4s",
        "$description": "An indeterminate bar crossing its track once."
      },
      "blink": {
        "$type": "duration",
        "$value": "2.4s",
        "$description": "A status dot's slow pulse \u2014 noticeable at the edge of vision, not distracting."
      }
    },
    "ease": {
      "out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.22, 0.61, 0.36, 1)"
      },
      "in-out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
      },
      "overshoot": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)"
      }
    },
    "stagger": {
      "step": {
        "$type": "duration",
        "$value": "26ms"
      },
      "cap": {
        "$type": "duration",
        "$value": "320ms"
      }
    },
    "drift": {
      "$type": "dimension",
      "$value": "6px"
    },
    "reactor": {
      "$description": "The reactor's own clock: rotation periods and the breath. Three speeds so the rings never phase-lock.",
      "blades": {
        "$type": "duration",
        "$value": "120s"
      },
      "coil": {
        "$type": "duration",
        "$value": "80s"
      },
      "iris-a": {
        "$type": "duration",
        "$value": "26s"
      },
      "iris-b": {
        "$type": "duration",
        "$value": "41s"
      },
      "breathe": {
        "$type": "duration",
        "$value": "5s"
      },
      "glint": {
        "$type": "duration",
        "$value": "14s"
      },
      "level": {
        "$type": "duration",
        "$value": "3.4s"
      }
    },
    "ambient": {
      "$description": "Ambient drift: rotations slow enough to read as alive rather than as motion.",
      "blink-slow": {
        "$type": "duration",
        "$value": "2.6s"
      },
      "drift": {
        "$type": "duration",
        "$value": "18s"
      },
      "drift-slow": {
        "$type": "duration",
        "$value": "40s"
      }
    }
  },
  "chrome": {
    "grid-size": {
      "$type": "dimension",
      "$value": "46px"
    },
    "grid-mask": {
      "$type": "other",
      "$value": "radial-gradient(ellipse 85% 70% at 50% 30%, #000 30%, transparent 90%)"
    },
    "bracket-size": {
      "$type": "dimension",
      "$value": "clamp(20px, 3vw, 38px)"
    },
    "bracket-inset": {
      "$type": "dimension",
      "$value": "10px"
    },
    "focus-outline": {
      "$type": "other",
      "$value": "2px solid {color.focus}"
    },
    "focus-offset": {
      "$type": "dimension",
      "$value": "2px"
    },
    "rule-live": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "The accent rule that marks the one row happening now: an inset box-shadow, not a border, so it does not move the layout."
    },
    "measure-dialog": {
      "$type": "dimension",
      "$value": "32rem",
      "$description": "How wide a modal question gets before it stops growing."
    },
    "measure-orb": {
      "$type": "dimension",
      "$value": "520px",
      "$description": "The HUD orb stops growing here: bigger reads as a lava lamp, not an instrument."
    },
    "measure-boot": {
      "$type": "dimension",
      "$value": "360px",
      "$description": "The boot sequence's stage \u2014 the same square the orb settles into."
    },
    "measure-qr": {
      "$type": "dimension",
      "$value": "260px",
      "$description": "A pairing QR at the size a phone camera reads across a desk."
    },
    "measure-log": {
      "$type": "dimension",
      "$value": "22rem",
      "$description": "How tall a scrolling output pane gets before it stops growing and starts scrolling."
    }
  }
}
