# Copy to .env and fill in. NEVER commit .env.
# Long-lived HA access token for the Jarvis services (create in HA user profile).
JARVIS_HA_TOKEN=

# Home Assistant base URL as reachable from the docker host.
HA_URL=http://127.0.0.1:8123

# Ollama endpoint (never exposed beyond LAN/WireGuard).
OLLAMA_URL=http://127.0.0.1:11434

# Models
PLANNER_MODEL=qwen3:8b
CODER_MODEL=qwen2.5-coder:7b

# Assist pipeline name to use (must exist in HA).
JARVIS_PIPELINE=Jarvis

# Piper voice for TTS
JARVIS_TTS_VOICE=en_GB-alan-medium

# Shared secret between HA and jarvis-orchestrator. HA scripts pass this on
# every call; the orchestrator refuses requests without it.
ORCHESTRATOR_TOKEN=

# Approval signing secret for Tier-3 command execution (HMAC). Only HA's
# approval script knows it; the orchestrator verifies it. Distinct from
# ORCHESTRATOR_TOKEN by design: possession of the API token alone must NOT
# be enough to execute commands.
APPROVAL_SECRET=
