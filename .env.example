# Copy to .env and fill in. NEVER commit .env.
#
# This file is for the COMPANION stack (docker-compose.yml in this directory):
# the HUD, the orchestrator and the sandbox. jarvis-core has its own
# jarvis-core/.env.example for the assistant itself.

# --- jarvis-core, as the HUD reaches it -------------------------------------
# Base URL of the running jarvis-core, from the docker host.
JARVIS_URL=http://127.0.0.1:8080
# A jarvis-core access token. On first run jarvis-core prints one in a banner;
# mint more with `python -m jarvis --create-token <name>`.
JARVIS_TOKEN=

# Voice pipeline the HUD asks for, and the Piper voice it speaks with.
JARVIS_PIPELINE=Jarvis
JARVIS_TTS_VOICE=en_GB-alan-medium
# Milliseconds of silence before a spoken turn is considered finished.
#
# This is dead time on EVERY turn: the audio has stopped, the recogniser has
# not been told, nothing is happening. 550 is past the pauses people leave
# inside a sentence (a comma is 150-250ms, drawing breath 300-400ms) and well
# short of the gap that means "your turn". Raise it if you are being cut off
# mid-sentence; lower it if you are waiting. Held to 200-3000.
JARVIS_VAD_HANGOVER_MS=550

# --- pairing a phone from the console ---------------------------------------
# The QR code in the console's pairing panel mints a PERMANENT token for
# whatever scans it, so minting needs something that reaching this port does
# not give you. That something is this secret.
#
# THE SAME VALUE GOES IN jarvis-core/.env. Two containers, one secret,
# deliberately: jarvis-core is what validates it, and the console is what
# presents it. Set it in one and not the other and the halves disagree —
# jarvis-core refuses the mint, or the panel says it holds no secret at all.
#
# Leave it blank and pairing is off, which is the fail-closed default. The
# panel will say so, and you can hand the console a secret for the life of the
# process from the panel itself instead — but only this variable survives a
# restart, because a secret this console wrote down beside the admin token
# would make one stolen file worth both.
JARVIS_PAIRING_SECRET=

# --- the console's password -------------------------------------------------
# The console's `/ws` relay attaches JARVIS_TOKEN to whatever connects and its
# origin guard deliberately admits a client that sends no Origin, so anything
# that can reach :8199 is already an authenticated API client. This password is
# what stands between that and the pairing secret above.
#
# Three ways to set it, in the order the console checks them:
#
#   JARVIS_CONSOLE_PASSWORD_HASH  a `scrypt$...` line. Nothing recoverable.
#   JARVIS_CONSOLE_PASSWORD       plaintext, hashed in memory, never written.
#   neither                       first visitor to the console chooses one.
#
# The third is the easy one and it is fine: the choice is hashed and written to
# `.storage/console-password`, which the compose file mounts from
# ./jarvis-web-storage so it outlives the container. At least 10 characters.
JARVIS_CONSOLE_PASSWORD=
JARVIS_CONSOLE_PASSWORD_HASH=
# Only if the default location above is not wanted. Relative paths resolve
# against the console's working directory, which is /app inside the container.
JARVIS_CONSOLE_PASSWORD_FILE=

# --- models -----------------------------------------------------------------
# Ollama endpoint (never exposed beyond LAN/WireGuard).
OLLAMA_URL=http://127.0.0.1:11434
PLANNER_MODEL=qwen3:8b
CODER_MODEL=qwen2.5-coder:7b

# Any OpenAI-compatible server instead — LiteLLM, vLLM, llama.cpp's server, LM
# Studio, TGI, SGLang. Uncomment `backend: openai` in the `llm:` block of
# jarvis-core/config/configuration.yaml, then set these. Full worked example in
# jarvis-core/docs/openai-compat.md.
#
# LLM_URL and LLM_MODEL are OLLAMA_URL and OLLAMA_MODEL under names that make
# sense once the server is not Ollama — they feed the same two variables, so
# set either pair and never both.
#
# The `/v1` is not optional: a bare host:port is read as Ollama, because that
# is how every existing install writes its Ollama url.
# LLM_URL=http://litellm:4000/v1
# The name your ROUTER knows the model by, which is rarely the provider's name.
# LLM_MODEL=house-model
# The proxy's master key or a virtual key. It belongs in `jarvis-core/.env`,
# not this one: this stack is the HUD and the optional orchestrator, and
# neither of those talks to the conversation model.
# LLM_API_KEY=

# --- orchestrator + sandbox -------------------------------------------------
# Shared secret between jarvis-core and jarvis-orchestrator. jarvis-core's
# `orchestrator:` config block sends this on every call; the orchestrator
# refuses requests without it.
ORCHESTRATOR_TOKEN=

# Approval signing secret for Tier-3 command execution and for applying a
# generated diff. Sent ONLY after a human approved that exact action.
#
# This MUST be a different value from ORCHESTRATOR_TOKEN. That is the whole
# design: possession of the API token alone must not be enough to execute a
# command. jarvis-core logs an error at startup if the two match.
APPROVAL_SECRET=
