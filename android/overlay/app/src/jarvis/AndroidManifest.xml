<?xml version="1.0" encoding="utf-8"?>
<!--
  Jarvis flavor manifest. Merged on top of app/src/main/AndroidManifest.xml.
  Namespace comes from Gradle (io.homeassistant.companion.android), so the
  relative ".jarvis.*" component names resolve to
  io.homeassistant.companion.android.jarvis.* while the installed package is
  io.homeassistant.companion.android.jarvis (applicationIdSuffix ".jarvis").
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
          Siri-like activation surface. Transparent, never in recents, works on
          the lock screen. exported=true is required for the system to deliver
          ACTION_ASSIST (long-press home / assist gesture / adb am start).
        -->
        <activity
            android:name=".jarvis.JarvisAssistActivity"
            android:exported="true"
            android:theme="@style/Theme.JarvisTransparent"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTask"
            android:taskAffinity="io.homeassistant.companion.android.jarvis.assist"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          VoiceInteractionService so the app can hold the device assistant role
          (Settings > Apps > Default apps > Digital assistant app, or the
          Secure Settings written by scripts/adb-jarvis-role.sh on GrapheneOS).
        -->
        <service
            android:name=".jarvis.JarvisVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:label="Jarvis">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/jarvis_voice_interaction_service" />
        </service>

        <service
            android:name=".jarvis.JarvisVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!--
          Stub RecognitionService: android:recognitionService in
          jarvis_voice_interaction_service.xml must point at a real component
          on some OS versions or the voice-interaction entry is rejected.
          It reports ERROR_CLIENT immediately; actual STT is HA's Assist
          pipeline on the server.
        -->
        <service
            android:name=".jarvis.JarvisRecognitionService"
            android:exported="true"
            android:label="Jarvis (stub recognizer)">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>
</manifest>
