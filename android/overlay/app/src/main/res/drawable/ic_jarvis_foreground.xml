<?xml version="1.0" encoding="utf-8"?>
<!--
  Jarvis launcher icon foreground: the arc-reactor from the HUD.
  Adaptive-icon safe zone is the centre 66dp of 108dp, so all art stays
  within roughly r=33 of centre (54,54).
-->
