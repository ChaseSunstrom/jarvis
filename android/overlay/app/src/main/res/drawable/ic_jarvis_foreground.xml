        android:strokeWidth="1.5"
        android:strokeAlpha="0.55"
        android:fillColor="#00000000"
        android:pathData="M54,25 a29,29 0 1,0 0.1,0" />

    <!-- major ticks (12) -->
    <group android:name="ticks">
        <path android:strokeColor="#3FD8FF" android:strokeWidth="2" android:strokeAlpha="0.9"
            android:pathData="M54,21 L54,28" />
