# Copy to secrets.yaml and fill in. secrets.yaml must never be committed.
#
#     cp secrets.yaml.example secrets.yaml
#
# Reference a value from configuration.yaml (or any included file) with:
#
#     password: !secret mqtt_password
#
# Whole values only — a secret cannot be spliced into the middle of a longer
# string. If an API wants "Token abc123", store the whole "Token abc123" here,
# which is why the examples below include their prefixes.
#
# The shipped configuration.yaml uses none of these, so Jarvis starts fine
# without this file. Each one becomes required the moment you uncomment the
# block that uses it.

# --- MQTT broker (only if yours requires credentials) ----------------------
mqtt_password: "PUT-YOUR-BROKER-PASSWORD-HERE"

# --- Philips Hue bridge ----------------------------------------------------
# Press the link button, then POST to the bridge to mint this:
#   curl -X POST http://<bridge-ip>/api -d '{"devicetype":"jarvis#core"}'
hue_key: "PUT-YOUR-HUE-API-KEY-HERE"

# --- REST sensors and YAML tools ------------------------------------------
# Full header values, prefix included.
paperless_token: "Token PUT-YOUR-PAPERLESS-API-TOKEN-HERE"
weather_api_key: "PUT-YOUR-WEATHER-API-KEY-HERE"

# --- The optional orchestrator/sandbox pair (parent repo) ------------------
# Match these to ORCHESTRATOR_TOKEN and APPROVAL_SECRET in ../.env.
orchestrator_bearer: "Bearer PUT-ORCHESTRATOR_TOKEN-FROM-.env-HERE"
approval_secret: "PUT-APPROVAL_SECRET-FROM-.env-HERE"
