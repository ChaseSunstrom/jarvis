# Copy to .env, next to docker-compose.yml. NEVER commit .env.
#
#     cp .env.example .env
#
# Every value here is optional — `docker compose up -d` works with none of
# them. Each one either overrides a default baked into docker-compose.yml or
# switches on something that is off until you provide a secret.
#
# The three secrets below (SEARXNG_SECRET, JARVIS_BROWSER_TOKEN,
# BROWSER_APPROVAL_SECRET) have no defaults on purpose. Generate them once:
#
#     {
#       echo "SEARXNG_SECRET=$(openssl rand -hex 32)"
#       echo "JARVIS_BROWSER_TOKEN=$(openssl rand -hex 32)"
#       echo "BROWSER_APPROVAL_SECRET=$(openssl rand -hex 32)"
#     } >> .env

# --- The installation ------------------------------------------------------
# Must match `jarvis: time_zone:` in config/configuration.yaml, or every time
# trigger fires at the wrong hour with nothing in the log to say so.
TZ=Europe/London

# Unset (the normal case) means Jarvis mints an API token on first run and
# prints it in a startup banner. Set it to pin a known one instead.
JARVIS_TOKEN=

# Pairing a phone by scanning a QR in the console. UNSET MEANS OFF.
#
# Deliberately a second secret rather than reusing JARVIS_TOKEN. jarvis-web's
# relay attaches the API token to whatever connects to it, and its origin guard
# admits a client that sends no Origin header, because that is what a
# non-browser client looks like. So anything that can reach the console's port
# is already an authenticated API client — and if the API token alone could
# mint a pairing code, a script with reach for one minute could claim it and
# keep a permanent token. This is the secret that stops that, and jarvis-web
# never holds it: you type it into the pairing panel, it is forwarded, and
# nothing stores it.
#
# Generate one with:  python3 -c "import secrets;print(secrets.token_urlsafe(24))"
JARVIS_PAIRING_SECRET=

# --- Voice -----------------------------------------------------------------
# PIPER_VOICE must match `voice: tts: voice:` in configuration.yaml — it is
# the voice the container actually loads. WAKE_WORD must match
# `voice: wake: model:`. tests/test_packaging.py fails the build if they drift.
PIPER_VOICE=en_GB-alan-medium
# How fast Piper speaks: the length scale is the duration multiplier, so 0.9
# is a tenth quicker than the voice's own pace and 1.1 a tenth slower. 0.9 is
# what the operator asked for ("slightly faster", 26 Aug); the rig's WER
# threshold is the check that it is still understood. Kokoro (`voice: tts:
# engine: openai`) has `speed:` in configuration.yaml instead — 1.0 is normal,
# so the two knobs point the same way with different numbers.
PIPER_LENGTH_SCALE=0.9
WAKE_WORD=hey_jarvis
WHISPER_MODEL=base.en
VOICE_LANGUAGE=en

# --- Private web search (docs/search.md) -----------------------------------
# Where web.search goes. If you run SearXNG here:
#
#     docker compose --profile search up -d
#
# ...leave this at the default. If you already run one on the LAN, point at it
# and skip the profile. Either way the instance MUST have the `json` format
# enabled (search.formats: [html, json]) — it is off by default upstream, and
# without it every search comes back 403. See searxng/README.md.
#
# There is no cloud fallback. Unset or unreachable means web.search fails with
# an explanation; it will never quietly call Google. Pointed at a SearXNG
# elsewhere, the stack's own instance (this default) is asked when that one
# cannot search — timed out, or every engine unresponsive — and the search
# result says which instance answered. `web: searxng_fallback_url:` in
# configuration.yaml changes or disables that.
SEARXNG_URL=http://127.0.0.1:8888

# --- AgentSearch (optional, in FRONT of SearXNG) -----------------------------
# https://github.com/brcrusoe72/agent-search
#
# It does not replace SearXNG, it wraps it: AgentSearch still needs the
# instance above to be up, and its own SEARXNG_URL is what points at one. What
# it adds is the work an agent otherwise does for itself — fetching and reading
# the pages, deduplicating and scoring across engines, detecting paywalls and
# scrubbing prompt injections — in a single call.
#
# Set this and web.search goes through it. Leave it empty and nothing changes.
# There is still no cloud fallback: if AgentSearch is configured and down,
# search fails and says so rather than silently reverting to the bare SearXNG
# behind it and returning results missing everything it was chosen for.
# AGENT_SEARCH_URL=http://127.0.0.1:3939
# Only if you started AgentSearch with AGENT_SEARCH_TOKEN set.
# AGENT_SEARCH_TOKEN=
# One of its named modes: general | code | academic | news | private |
# reference | community. Empty uses the plain /search.
# AGENT_SEARCH_STRATEGY=

# Required by the `search` profile. SearXNG refuses to start without it.
SEARXNG_SECRET=

# Loopback by default. The stack is on host networking, so this is what
# decides who can reach SearXNG at all.
SEARXNG_BIND_ADDRESS=127.0.0.1
SEARXNG_PORT=8888

# --- Browsing and crawling (jarvis-browser) --------------------------------
# BOTH are required — the service refuses to start without them, because an
# unauthenticated browser-automation service on the LAN is a
# remote-code-execution-shaped hole.
#
# Keep them DIFFERENT VALUES. That is the entire point of there being two: the
# model holds the API token on every tool call, and holding it must not be
# enough to approve a click on "Pay". Only /approve accepts the second one.
JARVIS_BROWSER_TOKEN=
BROWSER_APPROVAL_SECRET=

# Domains where the agent may CLICK AND TYPE, not merely read. Comma-separated.
# EMPTY MEANS EVERY DOMAIN IS REFUSED, which is the correct default — reading a
# page is one thing, acting on one is another. Keep this in step with
# `web: act_allowlist:` in config/configuration.yaml.
BROWSER_ACT_ALLOWLIST=

# Hosts never fetched, whatever else says otherwise. Wins over everything.
BROWSER_DENYLIST=

# LAN/loopback hosts exempt from the SSRF block — your printer's status page,
# say. Exact hostname match only. Every name here is a hole you opened
# deliberately.
BROWSER_LAN_ALLOWLIST=

BROWSER_RESPECT_ROBOTS=true

# Chromium's own sandbox needs unprivileged user namespaces in the container.
# If the browser dies with "Operation not permitted", prefer granting those
# over setting this to 1 — it removes a real layer of isolation.
BROWSER_CHROMIUM_NO_SANDBOX=0

# --- Offline geocoder ------------------------------------------------------
# A country extract instead of the full planet index. Unset = planet, which is
# tens of GB and takes a long while on first start.
PHOTON_REGION=
PHOTON_UPDATE_STRATEGY=PARALLEL

# --- The optional orchestrator/sandbox pair (commented out in compose) ------
# Both services are commented out in docker-compose.yml; these do nothing
# until you uncomment them. See ../.env.example in the parent repo.
# Where the model is, and what it is called.
#
# A base URL ending in /v1 for anything OpenAI-compatible — llama-swap,
# llama.cpp's server, vLLM, LM Studio, LiteLLM — or an Ollama base URL for
# Ollama's own wire. Jarvis infers which from the URL.
#
# It must be a machine you own: `llm: local_only:` refuses a public address at
# startup, because "100% local" is the point.
LLM_URL=http://127.0.0.1:11434
# The model, named as YOUR server names it: the id in llama-swap's config, the
# tag in Ollama's.
LLM_MODEL=qwen3:8b

# The old names for the two above. Still read when LLM_URL/LLM_MODEL are unset,
# so an install that predates the rename keeps working.
#OLLAMA_URL=http://127.0.0.1:11434
#OLLAMA_MODEL=qwen3:8b

# --- ...or any OpenAI-compatible server -------------------------------------
# LiteLLM, vLLM, llama.cpp's server, LM Studio, TGI, SGLang. Uncomment
# `backend: openai` in the `llm:` block of config/configuration.yaml first;
# docs/openai-compat.md is the worked example.
#
# LLM_URL and LLM_MODEL are the two above under names that make sense once the
# server is not Ollama — they feed the same container variables, so setting
# either pair works and you never have to set both.
#
# The `/v1` is not optional: a bare host:port is read as Ollama, because that
# is how every existing install writes its Ollama url.
# LLM_URL=http://litellm:4000/v1
# The name your ROUTER knows the model by, which is rarely the provider's name.
# LLM_MODEL=house-model
LLM_API_KEY=
PLANNER_MODEL=qwen3:8b
CODER_MODEL=qwen2.5-coder:7b
ORCHESTRATOR_TOKEN=
APPROVAL_SECRET=

# --- Graphs from an InfluxDB you already run --------------------------------
#
# Optional. A homelab usually has one already — the UPS, the rack's power, a
# GPU's temperature — and re-plumbing those into Jarvis so they can be graphed
# would be absurd, so Jarvis reads yours. It never writes to it.
#
# Any generation: 1.x (InfluxQL), 2.x (Flux) or 3.x. Jarvis asks /health and
# /ping which one it is talking to. Turn it on by naming `influx` under
# `metrics: sources:` in configuration.yaml.
#
# The token travels in an Authorization header, never in a URL.
#INFLUX_URL=http://127.0.0.1:8086
#INFLUX_TOKEN=
#INFLUX_ORG=
#INFLUX_BUCKET=homelab

# --- who Jarvis is on your filesystem ---------------------------------------
# The container writes .storage/ and the recorder database into ./config, which
# is a bind mount, so the uid inside the container has to be able to write the
# directory outside it. The image's own uid is 10003; set these to YOUR uid and
# gid (`id -u`, `id -g`) if ./config is a directory you also edit — otherwise
# your own config files end up owned by a user that does not exist on the host.
JARVIS_UID=10003
JARVIS_GID=10003

# --- retrieval: embeddings and reranking (M33) ------------------------------
#
# Two containers, both CPU, both tiny. They exist so that embeddings do NOT go
# through llama-swap: an embedding request there evicts KV cache the voice path
# is using, so writing a note made the next spoken sentence slower.
#
# Measured on this host: the embedder is 329 MB resident and answers in 9 ms;
# the reranker is 218 MB. Both models are downloaded on first start into
# ./models/embeddings (gitignored, like ./wyoming).
#
# Leave these alone unless you are changing models. Unset RERANK_URL to turn
# reranking off — retrieval falls back to keyword-plus-semantic, which is what
# shipped before.
EMBEDDINGS_URL=http://127.0.0.1:7997
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_PORT=7997
RERANK_URL=http://127.0.0.1:7998
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_PORT=7998

# --- your own n8n, if you run one (M37) -------------------------------------
#
# The bridge is OFF in configuration.yaml and this does nothing until you turn
# it on and name the workflows you want reachable. The API key goes in
# secrets.yaml, not here.
#N8N_URL=http://127.0.0.1:5678

# --- n8n (M77) ---------------------------------------------------------------
# The house's workflow server. Empty means off. The key comes from Settings →
# n8n API in n8n; the assistant URL is whatever answers there — a Chat Trigger's
# webhook — defaulting to <N8N_URL>/assistant. Running, activating, creating and
# changing a workflow are held for your approval; listing and asking are not.
N8N_URL=
N8N_API_KEY=
N8N_ASSISTANT_URL=
