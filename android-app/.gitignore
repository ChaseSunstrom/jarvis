*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
# Unanchored: the real output dir is app/build, not just ./build.
build/
/captures
.externalNativeBuild
.cxx
local.properties

# Generated by `gradle wrapper` — the properties file IS committed, the jar and
# scripts are not (see README: run `gradle wrapper` once).
gradle/wrapper/gradle-wrapper.jar
gradlew
gradlew.bat

# Signing material never belongs in the repo.
*.jks

# The ONE keystore that is deliberately committed. Signing every CI
# build with a stable key is what lets an update install over the
# previous one — Android refuses a signature change — so an ignored
# keystore here would silently break the in-app updater. Its password is
# public; see android-app/README.md for what that does and does not mean.
!ci-keystore.jks
*.keystore
keystore.properties

# The executable specs under tools/ are run with python3/pytest.
__pycache__/
.pytest_cache/
