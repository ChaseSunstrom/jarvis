<?xml version="1.0" encoding="utf-8"?>
<!--
  Jarvis — standalone Android app (ai.jarvis.app). No Home Assistant code, no
  Google Play Services, no Firebase.

  This file is DELIBERATELY COMPLETE: it declares every permission and every
  component the assist, automation and trigger modules need, so no other module
  has to edit it. Components under ai.jarvis.app.automation.** are declared here
  but IMPLEMENTED by the automation module.

  About the permission list. A permission in this manifest is only a *capability
  declaration*. Nothing here grants anything: every dangerous permission is
  requested at runtime, at the moment it is first needed, and every action that
  uses one is gated by the device-local policy table:

    Tier 1 AUTO    — read-only or trivially reversible; runs without asking.
    Tier 2 NOTIFY  — recoverable state change; ask once, then remember per action.
    Tier 3 CONFIRM — full-screen consent EVERY time, showing the verbatim action,
                     parameters and reason. Never auto-approved, never remembered.

  The tier is decided by a LOCAL table on the device. The `tier` field in an
  incoming server command may only RAISE it (max(local, incoming)), never lower
  it. See ai.jarvis.app.ui.ApprovalBridge and the automation module's policy
  store. Each permission below is tagged with the highest tier it serves.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================== transport ===================== -->
    <!-- Tier 1. Talking to jarvis-core over LAN/WireGuard. Cleartext is
         restricted to the documented hosts in @xml/network_security_config. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ===================== voice ===================== -->
    <!-- Tier 1 (the user initiates every capture: gesture, tap or wake word).
         Audio is streamed to the server's STT and never written to disk. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Tier 1. Volume / audio routing for TTS playback and barge-in. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ===================== notifications ===================== -->
    <!-- Tier 1 to post a local notification; ALSO the delivery path for Tier-3
         consent prompts when the app is in the background — denying this makes
         approvals time out, which fails closed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Tier 3 support: raises a pending consent prompt over the lock screen.
         On Android 14+ this is granted only to calling/alarm apps, so we treat
         a downgrade to a heads-up notification as the normal case. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Tier 3 support: lets the consent prompt start from the background at
         all. Special access — the user grants it in Settings > Apps > Special
         app access > Display over other apps. Without it, a Tier-3 request
         arriving while the app is backgrounded can only be answered by tapping
         its notification. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ===================== foreground services ===================== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Wake-word / open-mic listening in a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Short-lived sync work kicked off by a command. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The persistent command channel to jarvis-core. It is a long-lived
         WebSocket, which none of the narrower FGS types describe. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Special access, user-granted in Settings; keeps the command channel
         alive on aggressive OEM/Graphene battery policies. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ===================== device feedback ===================== -->
    <!-- Tier 1. Haptic tick when the orb appears. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Tier 1. Torch, via CameraManager.setTorchMode. FLASHLIGHT is a legacy
         normal permission; the torch itself needs no dangerous permission. -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <!-- Tier 2. Ringer mode / Do Not Disturb changes. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Tier 2. Special access (Settings.System.canWrite) — screen brightness,
         auto-rotate and friends. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- ===================== location ===================== -->
    <!-- Tier 1 for a coarse fix ("where am I", "is it far"). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Tier 2. Precise fix — navigation, geofenced triggers. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Tier 2. Location-based triggers while the app is not in use. Requested
         separately, after foreground location, exactly as the platform demands. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ===================== people ===================== -->
    <!-- Tier 3, always. Anything that contacts another human is CONFIRM. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Tier 1 (resolve a name to a number for the consent prompt) — but the
         send/call it feeds is Tier 3. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Tier 1. Call state, so Jarvis shuts up during a call. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- ===================== calendar ===================== -->
    <!-- Tier 1 to read. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Tier 2 to create/modify an event. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- ===================== alarms ===================== -->
    <!-- Tier 2. Setting an alarm/timer, and scheduling automation triggers. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- ===================== camera & media ===================== -->
    <!-- Tier 2. "What am I looking at" — an explicit, user-visible capture. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Tier 2. Reading media the user points Jarvis at. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ===================== bluetooth ===================== -->
    <!-- Tier 1. Car/headset connection state drives the wake-word gate. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- ===================== packages ===================== -->
    <!--
      "Open <app>" by name needs the full launcher list, which is what
      QUERY_ALL_PACKAGES is for. Everything else Jarvis resolves is an
      INTENT, and an intent is visible through a <queries> entry without
      any permission at all — see the <queries> block below.

      That distinction matters on GrapheneOS. QUERY_ALL_PACKAGES is one of
      the permissions a hardened setup is most likely to have stripped, and a
      feature that silently stops working is worse than one that was never
      built. So the intents Jarvis needs are declared explicitly and keep
      working when this permission is gone; only "list every installed app"
      degrades, and it degrades to a clear "no matching app" rather than a
      crash.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
      Package visibility for the specific things Jarvis hands off to. None of
      these needs QUERY_ALL_PACKAGES; declaring them means the handoff still
      resolves on a device where that permission was denied.
    -->
    <queries>
        <!-- Anything with a launcher entry: "open Maps". -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Browser, for opening a link. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Dialler and SMS. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Navigation. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- Sharing text, e.g. a task result. -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- The QR scanner the settings screen offers to hand the token to. -->
        <intent>
            <action android:name="com.google.zxing.client.android.SCAN" />
        </intent>
        <!-- Shizuku, when the user has installed it for shell actions. -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!-- ===================== privileged shell ===================== -->
    <!-- Tier 3, every time. Shizuku is optional and not bundled; the automation
         module adds the client library if shell actions are wanted. Declaring
         the permission string here costs nothing when Shizuku is absent. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Hardware is optional so the app installs on any device. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:name=".JarvisApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_jarvis"
        android:roundIcon="@mipmap/ic_jarvis"
        android:theme="@style/Theme.Jarvis"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!--
          The Jarvis home: orb, tap-to-talk, live transcript, and the nav to
          Management / Automations / Settings.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Siri-like activation surface. Transparent, never in recents, works on
          the lock screen. exported=true is required for the system to deliver
          ACTION_ASSIST (assist gesture / assistant role / adb am start).
        -->
        <activity
            android:name=".JarvisAssistActivity"
            android:exported="true"
            android:theme="@style/Theme.JarvisTransparent"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTask"
            android:taskAffinity="ai.jarvis.app.assist"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          One frame of Activity, so that starting the microphone service is
          legal. Android refuses a background start of a foreground service
          typed `microphone`, which is why "always on" stopped after every
          reboot; a start from a resumed Activity is always permitted. Every
          one-tap repair — the notification, the quick-settings tile — points
          here. Not exported: only this app's own PendingIntents reach it.
        -->
        <activity
            android:name=".ListenTrampolineActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisInvisible"
            android:excludeFromRecents="true"
            android:taskAffinity="ai.jarvis.app.listen"
            android:noHistory="true" />

        <!-- Server URL, token, pipeline, device name, wake-word gating. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/activity_settings"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          The GrapheneOS checklist: every permission and special access Jarvis
          can use, whether it has it, what breaks without it, and a button that
          opens the exact settings page. This is the screen that answers "it
          installed but nothing happens".
        -->
        <activity
            android:name=".ui.SystemCheckActivity"
            android:exported="false"
            android:label="@string/activity_system_check"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          Crash logs, readable on the device. crash/JarvisCrashHandler writes
          them; this shows them. No cable, no laptop, no logcat.
        -->
        <activity
            android:name=".ui.CrashLogActivity"
            android:exported="false"
            android:label="@string/activity_crash_logs"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!-- WebView onto jarvis-core's own management UI, locked to that origin. -->
        <activity
            android:name=".ManagementActivity"
            android:exported="false"
            android:label="@string/activity_management"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          THE TIER-3 CONSENT SCREEN. Full-screen over anything, including the
          lock screen. launchMode is standard on purpose: two concurrent
          requests stack, and each instance answers its own request id rather
          than one silently replacing the other. exported=false — only this app
          may raise a consent prompt.
        -->
        <activity
            android:name=".ApprovalActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisApproval"
            android:label="@string/activity_approval"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="standard"
            android:taskAffinity="ai.jarvis.app.approval"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          THE CROSS-DEVICE QUESTION SCREEN — jarvis-core asking YOU something
          and waiting for the answer. A close relative of ApprovalActivity, and
          the differences are deliberate:

          exported=false — only this app may raise a question, so no other app
          can forge one, and the message_id extras cannot be supplied from
          outside. launchMode standard, like the consent screen: two questions
          stack and each answers its own message_id rather than one silently
          replacing the other and leaving the server waiting on a reply that
          will never come. Its own taskAffinity so it never lands in the main
          Jarvis task. configChanges covers rotation: a recreated activity
          reports `dismissed` in onDestroy, which would escalate a question the
          user is in the middle of reading. No android:noHistory — the question
          must survive the user glancing at another app.
        -->
        <activity
            android:name=".companion.CompanionAskActivity"
            android:exported="false"
            android:theme="@style/Theme.JarvisApproval"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="standard"
            android:taskAffinity="ai.jarvis.app.companion"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          VoiceInteractionService so the app can hold the device assistant role
          (Settings > Apps > Default apps > Digital assistant app, or the Secure
          Settings written by adb — see README).
        -->
        <service
            android:name=".assist.JarvisVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:label="@string/voice_interaction_label">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/jarvis_voice_interaction_service" />
        </service>

        <service
            android:name=".assist.JarvisVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!--
          Stub recognizer. android:recognitionService in
          jarvis_voice_interaction_service.xml must point at a resolvable
          component on several OS versions or the voice-interaction entry is
          rejected. It reports ERROR_CLIENT immediately; real STT is the
          server's pipeline.
        -->
        <service
            android:name=".assist.JarvisRecognitionService"
            android:exported="true"
            android:label="@string/recognition_service_label">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- ================================================================
             Implemented by the AUTOMATION module (ai.jarvis.app.automation.**).
             Declared here so that module never has to touch this file.
             ================================================================ -->

        <!--
          The device command channel: authenticated WebSocket to jarvis-core,
          device registration, command dispatch through the local policy table.
        -->
        <!--
          Always-on "Hey Jarvis". Holds the microphone open and streams it to
          the user's own server, which does the detecting; nothing is stored at
          either end. Only ever runs when `wakeWordEnabled` is set, and its
          notification is not dismissible while it does, because an open mic
          with no visible sign of it is not something to ship.
        -->
        <service
            android:name="ai.jarvis.app.assist.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          "Hey Jarvis" as a quick-settings tile, so turning listening back on
          after a reboot is a swipe rather than a trip through Settings.
          exported=true and the BIND permission are what the system requires to
          bind a tile; the permission is one only the system holds.
        -->
        <service
            android:name="ai.jarvis.app.assist.WakeTileService"
            android:exported="true"
            android:icon="@drawable/ic_jarvis_status"
            android:label="@string/tile_wake_word"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!--
          The quarter-hourly "is it still listening?" alarm. START_STICKY alone
          is not enough on 12+, because the restart the system performs after a
          kill is itself a background start of a microphone service and may be
          refused. Not exported, and its PendingIntent is explicit and
          immutable, so nothing outside this app can fire it.
        -->
        <receiver
            android:name="ai.jarvis.app.assist.WakeHeartbeatReceiver"
            android:exported="false" />

        <service
            android:name="ai.jarvis.app.automation.JarvisAutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent authenticated WebSocket to the user's self-hosted Jarvis server, so the device can receive and locally authorise commands." />
        </service>

        <!--
          UI automation. Off until the user enables it in Settings >
          Accessibility. Screen content it reads is untrusted data; every tap or
          text entry it performs is Tier 3.
        -->
        <service
            android:name="ai.jarvis.app.automation.accessibility.JarvisAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/jarvis_accessibility_service" />
        </service>

        <!--
          Notification listener — a TRIGGER source only. Notification text is
          untrusted data: it may start a rule evaluation, but it can never route
          into the action dispatcher without a fresh human approval.
        -->
        <service
            android:name="ai.jarvis.app.automation.notify.JarvisNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Restarts the command channel after a reboot. Protected broadcast. -->
        <receiver
            android:name="ai.jarvis.app.automation.triggers.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Trigger sources: power, connectivity, headset, airplane mode.
             All protected system broadcasts. -->
        <receiver
            android:name="ai.jarvis.app.automation.triggers.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
                <action android:name="android.intent.action.AIRPLANE_MODE" />
                <action android:name="android.intent.action.HEADSET_PLUG" />
                <action android:name="android.media.AUDIO_BECOMING_NOISY" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- Fired only by this app's own AlarmManager PendingIntents. -->
        <receiver
            android:name="ai.jarvis.app.automation.triggers.AlarmReceiver"
            android:exported="false" />

        <!--
          The automation module's two screens. MainActivity and SettingsActivity
          launch them by name (see ai.jarvis.app.ui.JarvisScreens) rather than by
          class reference, so this module never imports from that one. Provide
          classes with exactly these names and the links light up.
        -->
        <activity
            android:name="ai.jarvis.app.automation.ui.AutomationsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <activity
            android:name="ai.jarvis.app.automation.ui.AuditLogActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode" />

        <!--
          Jarvis on the car display. See ai.jarvis.app.car.JarvisCarAppService.

          `exported` must be true — the car host is another process and binds
          this by intent — which is exactly why the service validates its
          caller's signature rather than trusting the bind. The category is
          IOT, the platform's own name for controlling things in a house, which
          is what Jarvis does; claiming a navigation category would buy a real
          Canvas on the head unit and would be a lie to the host about what
          this app is.
        -->
        <service
            android:name=".car.JarvisCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.IOT" />
            </intent-filter>
        </service>

        <!--
          The minimum car API level this app needs. 1 is the templates the car
          app library shipped with, which is all JarvisCarScreen uses — asking
          for more would exclude older head units for nothing.
        -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

    </application>
</manifest>
